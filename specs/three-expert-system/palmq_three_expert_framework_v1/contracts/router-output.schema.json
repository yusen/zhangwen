{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RouterOutput",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "intent",
    "projectName",
    "initialExpert",
    "recommendedExperts",
    "confidence",
    "reason",
    "requiresClarification"
  ],
  "properties": {
    "intent": {
      "type": "string",
      "minLength": 1
    },
    "projectName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40
    },
    "initialExpert": {
      "enum": [
        "problem_guide",
        "smart_engineer",
        "structure_engineer"
      ]
    },
    "recommendedExperts": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "problem_guide",
          "smart_engineer",
          "structure_engineer"
        ]
      },
      "minItems": 1
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "requiresClarification": {
      "type": "boolean"
    }
  }
}
