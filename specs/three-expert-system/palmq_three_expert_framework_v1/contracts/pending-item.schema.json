{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PendingItem",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "projectId",
    "title",
    "description",
    "priority",
    "reason",
    "affectedExperts",
    "status"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "projectId": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "priority": {
      "enum": [
        "safety",
        "blocking",
        "conflict",
        "confirmation",
        "missing_input",
        "normal"
      ]
    },
    "reason": {
      "type": "string"
    },
    "affectedExperts": {
      "type": "array",
      "items": {
        "enum": [
          "problem_guide",
          "smart_engineer",
          "structure_engineer"
        ]
      }
    },
    "options": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "enum": [
        "open",
        "resolved",
        "dismissed"
      ]
    },
    "isHighlighted": {
      "type": "boolean"
    }
  }
}
