{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ExpertHandoff",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "projectId",
    "fromExpert",
    "toExpert",
    "handoffType",
    "confirmedRequirements",
    "relatedArtifacts",
    "requiredOutputs",
    "dependencies",
    "openQuestions"
  ],
  "properties": {
    "projectId": {
      "type": "string"
    },
    "fromExpert": {
      "enum": [
        "problem_guide",
        "smart_engineer",
        "structure_engineer"
      ]
    },
    "toExpert": {
      "enum": [
        "problem_guide",
        "smart_engineer",
        "structure_engineer"
      ]
    },
    "handoffType": {
      "enum": [
        "clarification",
        "implementation",
        "structure",
        "review",
        "change_request"
      ]
    },
    "confirmedRequirements": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "sharedFactIds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "relatedArtifacts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "requiredOutputs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "openQuestions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "currentPendingItemId": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
